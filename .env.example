# Supabase Configuration
# Replace these with your actual Supabase project URL and anon public key.
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default SCB Debit Account Number (Optional default)
NEXT_PUBLIC_SCB_DEBIT_ACCOUNT=0000000000000

# App Access Passcode (Optional: set a password to gate public access)
APP_ACCESS_PASSWORD=your-secure-passcode-here
